{
	"name": "vault-coach",
	"version": "1.5.5",
	"description": "Local knowledge Q&A and interview practice from your vault using Ollama.",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": ">=20.9.0 <23"
	},
	"scripts": {
		"local-ai:runtime-policy": "node scripts/generate-local-ai-runtime-policy.mjs",
		"predev": "npm run local-ai:runtime-policy",
		"dev": "node esbuild.config.mjs",
		"prebuild": "npm run local-ai:runtime-policy",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/verify-release-assets.mjs",
		"m4:validate": "node scripts/spikes/local-ai/validate-local-ai-assets.mjs",
		"m4:smoke:embedding": "node scripts/spikes/local-ai/embedding-smoke.mjs",
		"m4:smoke:browser-runtime": "node scripts/spikes/local-ai/browser-runtime-smoke.mjs",
		"m4:benchmark": "node scripts/run-local-ai-benchmark.mjs",
		"m4:build:obsidian-smoke": "node scripts/spikes/local-ai/build-obsidian-smoke.mjs",
		"pretest": "npm run local-ai:runtime-policy",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prelint": "npm run local-ai:runtime-policy",
		"lint": "eslint .",
		"release:verify": "node scripts/verify-release-assets.mjs"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@huggingface/transformers": "4.3.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "^1.13.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^0.34.6"
	},
	"dependencies": {
		"pdfjs-dist": "^4.2.67"
	},
	"overrides": {
		"brace-expansion": "^1.1.16",
		"minimatch": "^3.1.4",
		"tar": "^7.5.16"
	}
}
